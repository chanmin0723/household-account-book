rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // uid가 나를 친구 목록에 넣어뒀는가 = 내가 uid의 기록을 볼 수 있는가
    function friendOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/friends/$(me()));
    }

    // 친구 코드 → uid. 코드를 알아야만 조회 가능 (목록 조회 금지)
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if signedIn() && resource.data.uid == me();
    }

    match /users/{uid} {
      allow get: if signedIn() && (me() == uid || friendOf(uid));
      allow list: if false;
      allow write: if signedIn() && me() == uid;

      // 본인 또는 '그 친구 본인'만 추가/삭제 (서로 친구 맺기·끊기용)
      match /friends/{friendUid} {
        allow read: if signedIn() && me() == uid;
        allow write: if signedIn() && (me() == uid || me() == friendUid);
      }

      // 숨기지 않은 기록만 올라옴. 본인만 쓰고, 본인과 친구만 읽음
      match /entries/{entryId} {
        allow read: if signedIn() && (me() == uid || friendOf(uid));
        allow write: if signedIn() && me() == uid;
      }
    }
  }
}
